{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "REDscope analyzer rule set",
  "type": "array",
  "items": { "$ref": "#/definitions/rule" },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["id", "name", "severity", "verdict", "confidence", "match", "message"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "severity": { "type": "integer", "minimum": 1, "maximum": 6 },
        "verdict": { "enum": ["environmental", "mod", "engine", "memory", "unknown"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "message": { "type": "string", "minLength": 1 },
        "fix": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } },
        "match": { "$ref": "#/definitions/match" }
      }
    },
    "match": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "minSchema": { "type": "integer", "minimum": 1 },
        "exceptionCodeAny": { "$ref": "#/definitions/strList" },
        "crashClassAny": { "$ref": "#/definitions/strList" },
        "faultingModuleAny": { "$ref": "#/definitions/strList" },
        "stackModuleAll": { "$ref": "#/definitions/strList" },
        "stackModuleAny": { "$ref": "#/definitions/strList" },
        "stackModuleNone": { "$ref": "#/definitions/strList" },
        "scriptedFrameAll": { "$ref": "#/definitions/strList" },
        "scriptedFrameAny": { "$ref": "#/definitions/strList" },
        "scriptedFrameNone": { "$ref": "#/definitions/strList" },
        "installedModAny": { "$ref": "#/definitions/strList" },
        "installedModVersionMatches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "oomSuspected": { "type": "boolean" },
        "oomBasisContains": { "$ref": "#/definitions/strList" },
        "engineStateAny": { "$ref": "#/definitions/strList" },
        "tweakDbRecordAny": { "$ref": "#/definitions/strList" },
        "statusEffectRecordAny": { "$ref": "#/definitions/strList" },
        "findEntityNullCallerAny": { "$ref": "#/definitions/strList" },
        "recentDelayCallbackAny": { "$ref": "#/definitions/strList" },
        "wrapLayerModAny": { "$ref": "#/definitions/strList" },
        "inFlightClassAny": { "$ref": "#/definitions/strList" },
        "curatedConflictActive": { "type": "boolean" },
        "conflictGroupAny": { "$ref": "#/definitions/strList" },
        "setupHasIssues": { "type": "boolean" },
        "setupIssueKindAny": { "$ref": "#/definitions/strList" }
      }
    },
    "strList": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
